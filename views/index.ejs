<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai+Looped:wght@100;200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "IBM Plex Sans Thai Looped", sans-serif;
      }
      .filter-btn.active,
      .filter-btn:hover {
        background-color: #3b82f6;
        color: white;
      }
      .toggle-btn:hover div {
        border-color: #3b82f6;
      }
    </style>
  </head>
  <body class="bg-gray-100 min-h-screen py-8">
    <div class="container mx-auto max-w-4xl px-4">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
          <i class="fas fa-tasks text-blue-500 mr-3"></i>
          <%= title %>
        </h1>
      </div>

      <!-- Add Todo Form -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">เพิ่มงานใหม่</h2>
        <form id="addTodoForm" class="space-y-4">
          <div>
            <label
              for="title"
              class="block text-sm font-medium text-gray-700 mb-2"
              >หัวข้องาน *</label
            >
            <input
              type="text"
              id="title"
              name="title"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="ใส่หัวข้องาน..."
            />
          </div>
          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700 mb-2"
              >รายละเอียด</label
            >
            <textarea
              id="description"
              name="description"
              rows="3"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="ใส่รายละเอียดงาน (ไม่บังคับ)..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-blue-500 hover:bg-blue-600 text-white font-medium py-2 px-4 rounded-md transition duration-200 flex items-center justify-center"
          >
            <i class="fas fa-plus mr-2"></i>
            เพิ่มงาน
          </button>
        </form>
      </div>

      <!-- Todo Statistics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow-md p-4 text-center">
          <div class="text-2xl font-bold text-blue-500" id="totalTodos">
            <%= todos ? todos.length : 0 %>
          </div>
          <div class="text-sm text-gray-600">งานทั้งหมด</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-4 text-center">
          <div class="text-2xl font-bold text-green-500" id="completedTodos">
            <%= todos ? todos.filter(todo => todo.completed).length : 0 %>
          </div>
          <div class="text-sm text-gray-600">งานที่เสร็จแล้ว</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-4 text-center">
          <div class="text-2xl font-bold text-orange-500" id="pendingTodos">
            <%= todos ? todos.filter(todo => !todo.completed).length : 0 %>
          </div>
          <div class="text-sm text-gray-600">งานที่รอดำเนินการ</div>
        </div>
      </div>

      <!-- Filter Buttons -->
      <div class="flex justify-center mb-6">
        <div class="bg-white rounded-lg shadow-md p-1 flex">
          <button
            id="filterAll"
            class="filter-btn active px-4 py-2 rounded-md font-medium transition duration-200"
          >
            ทั้งหมด
          </button>
          <button
            id="filterPending"
            class="filter-btn px-4 py-2 rounded-md font-medium transition duration-200"
          >
            รอดำเนินการ
          </button>
          <button
            id="filterCompleted"
            class="filter-btn px-4 py-2 rounded-md font-medium transition duration-200"
          >
            เสร็จแล้ว
          </button>
        </div>
      </div>

      <!-- Todo List -->
      <div class="bg-white rounded-lg shadow-md">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-800">รายการงาน</h2>
        </div>
        <div id="todoList" class="divide-y divide-gray-200">
          <% if (todos && todos.length > 0) { %> <% todos.forEach(function(todo)
          { %>
          <div
            class="todo-item p-6 hover:bg-gray-50 transition duration-200"
            data-id="<%= todo._id %>"
            data-completed="<%= todo.completed %>"
          >
            <div class="flex items-start space-x-4">
              <!-- Checkbox -->
              <button class="toggle-btn flex-shrink-0 mt-1">
                <div
                  class="w-6 h-6 border-2 border-gray-300 rounded-md flex items-center justify-center hover:border-blue-500 transition duration-200 <%= todo.completed ? 'bg-green-500 border-green-500' : '' %>"
                >
                  <% if (todo.completed) { %>
                  <i class="fas fa-check text-white text-sm"></i>
                  <% } %>
                </div>
              </button>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <h3
                    class="todo-title text-lg font-medium text-gray-900 <%= todo.completed ? 'line-through text-gray-500' : '' %>"
                  >
                    <%= todo.title %>
                  </h3>
                  <div class="flex items-center space-x-2">
                    <span
                      class="status-badge px-2 py-1 text-xs font-medium rounded-full <%= todo.completed ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>"
                    >
                      <%= todo.completed ? 'เสร็จแล้ว' : 'รอดำเนินการ' %>
                    </span>
                  </div>
                </div>

                <% if (todo.description) { %>
                <p
                  class="todo-description text-gray-600 mt-1 <%= todo.completed ? 'line-through' : '' %>"
                >
                  <%= todo.description %>
                </p>
                <% } %>

                <div class="text-sm text-gray-400 mt-2">
                  สร้างเมื่อ: <%= new
                  Date(todo.createdAt).toLocaleDateString('th-TH', { year:
                  'numeric', month: 'long', day: 'numeric', hour: '2-digit',
                  minute: '2-digit' }) %>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex items-center space-x-2">
                <button
                  class="edit-btn text-blue-500 hover:text-blue-700 p-2 rounded-md hover:bg-blue-50 transition duration-200"
                  title="แก้ไข"
                >
                  <i class="fas fa-edit"></i>
                </button>
                <button
                  class="delete-btn text-red-500 hover:text-red-700 p-2 rounded-md hover:bg-red-50 transition duration-200"
                  title="ลบ"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
          <% }); %> <% } else { %>
          <div class="p-12 text-center">
            <i class="fas fa-clipboard-list text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-xl font-medium text-gray-500 mb-2">
              ยังไม่มีงานในรายการ
            </h3>
            <p class="text-gray-400">เริ่มต้นโดยการเพิ่มงานใหม่ด้านบน</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Edit Modal -->
    <div
      id="editModal"
      class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50"
    >
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800">แก้ไขงาน</h3>
        </div>
        <form id="editTodoForm" class="p-6 space-y-4">
          <input type="hidden" id="editTodoId" />
          <div>
            <label
              for="editTitle"
              class="block text-sm font-medium text-gray-700 mb-2"
              >หัวข้องาน *</label
            >
            <input
              type="text"
              id="editTitle"
              name="title"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          <div>
            <label
              for="editDescription"
              class="block text-sm font-medium text-gray-700 mb-2"
              >รายละเอียด</label
            >
            <textarea
              id="editDescription"
              name="description"
              rows="3"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            ></textarea>
          </div>
          <div class="flex justify-end space-x-3">
            <button
              type="button"
              id="cancelEdit"
              class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition duration-200"
            >
              ยกเลิก
            </button>
            <button
              type="submit"
              class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-md transition duration-200"
            >
              บันทึก
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Loading Spinner -->
    <div
      id="loadingSpinner"
      class="fixed inset-0 bg-black bg-opacity-30 hidden items-center justify-center z-50"
    >
      <div class="bg-white rounded-lg p-4 shadow-xl">
        <div class="flex items-center space-x-3">
          <div
            class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"
          ></div>
          <span class="text-gray-700">กำลังประมวลผล...</span>
        </div>
      </div>
    </div>

    <script src="/javascripts/todo.js"></script>
  </body>
</html>
